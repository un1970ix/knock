{
  "name": "knock",
  "main": "build/index.js",
  "compatibility_date": "2026-10-21",
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "dependencies_instrumentation": { "enabled": false },
  "vars": { "DIFFICULTY": "16" },
  "durable_objects": {
    "bindings": [{ "name": "GATES", "class_name": "Gate" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Gate"] }]
}
